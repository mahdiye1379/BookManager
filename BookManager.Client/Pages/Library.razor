@page "/library"
@using BookManager.Application.Interface
@inject NavigationManager Navigation
@inject IBookRepository bookRepository

<PageTitle>Library</PageTitle>

<div class="collection">
    <header class="collection-header">
        <div>
            <h1>My Library</h1>
            <p>Manage your books and track your reading progress.</p>
        </div>
        <button type="button" class="collection-add" @onclick="AddBookAsync">+ Add Book</button>
    </header>

    <form class="library-search"
          @onsubmit="SearchBooks"
          @onsubmit:preventDefault>

        <div class="library-search-field">
            <svg class="library-search-icon"
                 xmlns="http://www.w3.org/2000/svg"
                 width="22" height="22"
                 viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="1.8"
                 stroke-linecap="round"
                 aria-hidden="true">
                <circle cx="10.5" cy="10.5" r="7" />
                <path d="m16 16 4.5 4.5" />
            </svg>

            <input type="search"
                   aria-label="Search books by title"
                   placeholder="Find your next read..."
                   autocomplete="off"
                   @bind="SearchText"
                   @bind:event="oninput" />
        </div>

        <button type="submit" class="library-search-button" disabled="@isSearching">
            @(isSearching ? "Searching…" : "Search")
            <span aria-hidden="true">↗</span>
        </button>
    </form>


    @if (!string.IsNullOrWhiteSpace(searchError))
    {
        <p class="collection-message" role="alert">@searchError</p>
    }

    @if (!string.IsNullOrWhiteSpace(DeleteMessage))
    {
        <p class="collection-message" role="status">@DeleteMessage</p>
    }

    @if (books == null)
    {
        <p class="collection-state" role="status">Loading books…</p>
    }
    else if (books.Count == 0)
    {
        <section class="collection-state">
            @if (string.IsNullOrWhiteSpace(SearchText))
            {
                <h2>Your library is empty</h2>
                <p>Add your first book to start tracking your reading.</p>
            }
            else
            {
                <h2>No books found</h2>
                <p>Try another title.</p>
            }
        </section>
    }
    else
    {
        <div class="collection-heading">
            <h2>Your books</h2>
            <span>@books.Count @(books.Count == 1 ? "book" : "books")</span>
        </div>

        <div class="collection-grid">
            @foreach (var book in books)
            {
                var progress = book.TotalPage > 0
                    ? Math.Clamp((double)book.CurrentReadingPage / book.TotalPage * 100, 0, 100)
                    : 0;

                <article class="collection-card">
                    <div class="collection-book">
                        <a class="collection-cover" href="/book/details/@book.ID"
                           aria-label="@($"View {book.Title}")">
                            @if (string.IsNullOrWhiteSpace(book.Cover))
                            {
                                <span aria-hidden="true">▤</span>
                            }
                            else
                            {
                                <img src="@book.Cover" alt="" loading="lazy" />
                            }
                        </a>
                        <div class="collection-info">
                            <span class="collection-category">@(book.Category?.Name ?? "Unknown")</span>
                            <h3><a href="/book/details/@book.ID">@book.Title</a></h3>
                            <p>@(book.Author?.Name ?? "Unknown")</p> 
                        </div>
                    </div>
                    <div class="collection-progress">
                        <div>
                            <span>Reading progress</span>
                            <span>@book.CurrentReadingPage / @book.TotalPage pages</span>
                        </div>
                        <progress max="100" value="@progress.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                  aria-label="@($"Reading progress for {book.Title}")"></progress>
                    </div>
                    <footer class="collection-actions">
                        <time datetime="@book.LastUpdate.ToString("yyyy-MM-dd")">Updated @book.LastUpdate.ToString("yyyy-MM-dd")</time>
                        <button type="button" class="collection-edit"
                                aria-label="@($"Edit {book.Title}")"
                                @onclick="() => EditBookAsync(book.ID)">Edit</button>
                        <button type="button" class="collection-delete"
                                aria-label="@($"Delete {book.Title}")"
                                @onclick="() => DeleteBook(book.ID)">Delete</button>
                    </footer>
                </article>
            }
        </div>
    }
</div>

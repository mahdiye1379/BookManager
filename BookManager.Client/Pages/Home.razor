@page "/"
@using BookManager.Domain.Model
@using BookManager.Application.Interface
@inject IBookRepository bookRepository

<PageTitle>My Library</PageTitle>

<div class="library-page">

    <!-- Header -->
    <div class="library-header">
        <div>
            <h1>Programming Books </h1>
            <p>Your personal collection of books</p>
        </div>

        <div class="book-count">
            <span class="count-number">@Books.Count</span>
            <span class="count-label">Books</span>
        </div>

    </div>

    <!-- Search -->
    <div class="search-container">
        <input type="text"
               class="book-search"
               placeholder="🔍 Search books by title..."
               @bind="SearchText"
               @bind:event="oninput" />

        <button class="search-button"
                @onclick="SearchBooks">
            Search
        </button>
    </div>

    <!-- Books -->
    @if (Books.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-icon">📚</div>
            <h2>No books yet</h2>
            <p>Your library is currently empty.</p>
        </div>
    }

    else
    {
        <div class="books-grid">

            @foreach (Book item in Books)
            {
                <div class="book-card">
                
                    <a href="/book/details/@item.ID" style="text-decoration:none;">

                    <div class="book-cover">
                        <div class="book-icon">
                               <img src="@item.Cover" style="width:100%;height:100%"/>
                        </div>
                    </div>

                    <div class="book-content">
                        <h2>@item.Title</h2>

                        <p class="book-description">
                            A book in your personal collection.
                        </p>

                        <div class="book-footer">
                            <span class="book-status">In Library</span>
                        </div>
                    </div>

                    </a>

                </div>
            }

        </div>
    }

</div>


<!-- Pagination -->

<div class="pagination-container">
    
    <button class="pagination-button"
            disabled="@(CurrentPage == 1)"
            @onclick="PreviousPage">
        Previous
    </button>

    @for (int i = 1; i <= TotalPage; i++)
    {
        int pageNumber = i;

        <button class="pagination-button @(CurrentPage == pageNumber ? "active" : "")"
                @onclick="() => ChangePage(pageNumber)">
            @pageNumber
        </button>
    }

    <button class="pagination-button"
            disabled="@(CurrentPage >= TotalPage)"
            @onclick="NextPage">
        Next
    </button>

</div>

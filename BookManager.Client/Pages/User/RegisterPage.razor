@page "/Register"
@using BookManager.Application.Interface
@inject IUserRepository userRepository

<PageTitle>Create Account</PageTitle>

<div class="register-page">
    <header class="account-intro">
        <h1>Build your reading library</h1>
        <p>Create an account to organize books and track your progress.</p>
    </header>

    <div class="register-card">

        <div class="register-header">
            <h2>Create Account</h2>
            <p>Register to start using BookManager</p>
        </div>

        <EditForm class="register-fields" Model="@registerDTO" OnValidSubmit="@RegisterUser">
            <DataAnnotationsValidator />

            <div class="form-group">
                <label for="register-UserName">Username</label>

                <InputText id="register-UserName" autocomplete="username" @bind-Value="registerDTO.UserName"
                           class="form-control"
                           placeholder="Enter your username" />

                <ValidationMessage For="@(() => registerDTO.UserName)" />
            </div>

            <div class="form-group">
                <label for="register-Email">Email</label>

                <InputText id="register-Email" autocomplete="email" @bind-Value="registerDTO.Email"
                           class="form-control"
                           type="email"
                           placeholder="Enter your email" />

                <ValidationMessage For="@(() => registerDTO.Email)" />
            </div>

            <div class="form-group register-wide">
                <label for="registration-phone">Phone Number</label>

                <InputText id="registration-phone" autocomplete="tel" @bind-Value="registerDTO.PhoneNumber"
                           class="form-control"
                           placeholder="Enter your phone number" />

                <ValidationMessage For="@(() => registerDTO.PhoneNumber)" />
            </div>

            <div class="form-group">
                <label for="register-Password">Password</label>

                <InputText id="register-Password" autocomplete="new-password" @bind-Value="registerDTO.Password"
                           class="form-control"
                           type="password"
                           placeholder="Enter your password" />

                <ValidationMessage For="@(() => registerDTO.Password)" />
            </div>

            <div class="form-group">
                <label for="register-ConfirmPassword">Confirm Password</label>

                <InputText id="register-ConfirmPassword" autocomplete="new-password" @bind-Value="registerDTO.ConfirmPassword"
                           class="form-control"
                           type="password"
                           placeholder="Confirm your password" />

                <ValidationMessage For="@(() => registerDTO.ConfirmPassword)" />
            </div>

            <button type="submit" class="register-button">
                Create Account
            </button>

        </EditForm>

        @if (!string.IsNullOrEmpty(Message))
        {
            <div class="message">
                @Message
            </div>
        }

        <div class="login-link">
            Already have an account?
            <a href="/login">Login</a>
        </div>

    </div>
    
</div>

@page "/Register"
<h3>RegisterPage</h3>

<div class="register-page">

    <div class="register-card">

        <div class="register-header">
            <h2>Create Account</h2>
            <p>Register to start using BookManager</p>
        </div>

        <EditForm Model="@registerDTO" OnValidSubmit="@RegisterUser">  
            <DataAnnotationsValidator />

            <div class="form-group">
                <label>Username</label>

                <InputText @bind-Value="registerDTO.UserName"
                           class="form-control"
                           placeholder="Enter your username" />

                <ValidationMessage For="@(() => registerDTO.UserName)" />
            </div>

            <div class="form-group">
                <label>Email</label>

                <InputText @bind-Value="registerDTO.Email"
                           class="form-control"
                           type="email"
                           placeholder="Enter your email" />

                <ValidationMessage For="@(() => registerDTO.Email)" />
            </div>

            <div class="form-group">
                <label>Phone Number</label>

                <InputText @bind-Value="registerDTO.PhoneNumber"
                           class="form-control"
                           placeholder="Enter your phone number" />

                <ValidationMessage For="@(() => registerDTO.PhoneNumber)" />
            </div>

            <div class="form-group">
                <label>Password</label>

                <InputText @bind-Value="registerDTO.Password"
                           class="form-control"
                           type="password"
                           placeholder="Enter your password" />

                <ValidationMessage For="@(() => registerDTO.Password)" />
            </div>

            <div class="form-group">
                <label>Confirm Password</label>

                <InputText @bind-Value="registerDTO.ConfirmPassword"
                           class="form-control"
                           type="password"
                           placeholder="Confirm your password" />

                <ValidationMessage For="@(() => registerDTO.ConfirmPassword)" />
            </div>

            <button type="submit" class="register-button">
                Create Account
            </button>

        </EditForm>

        @if (!string.IsNullOrEmpty(Message))
        {
            <div class="message">
                @Message
            </div>
        }

        <div class="login-link">
            Already have an account?
            <a href="/login">Login</a>
        </div>

    </div>
    
</div>

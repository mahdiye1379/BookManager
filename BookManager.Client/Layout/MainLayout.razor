@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization

<div class="bm-shell">
    <header class="bm-header">
        <a class="bm-brand" href="/">
            <span class="bm-logo" aria-hidden="true">B</span>
            <span>BookManager</span>
        </a>
        <nav class="bm-account" aria-label="Account navigation">
            <AuthorizeView>
                <NotAuthorized>
                    <NavLink class="bm-action" href="/Login">Login</NavLink>
                    <NavLink class="bm-action bm-primary" href="/Register">Register</NavLink>
                </NotAuthorized>
                <Authorized>
                    <NavLink class="bm-action bm-primary" href="/UserPanel">
                        User Panel <span aria-hidden="true">↗</span>
                    </NavLink>
                </Authorized>
            </AuthorizeView>
        </nav>
    </header>

    <aside class="bm-sidebar">
        <NavMenu />
    </aside>

    <main class="bm-content">
        @Body
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss" title="Dismiss">×</span>
</div>
